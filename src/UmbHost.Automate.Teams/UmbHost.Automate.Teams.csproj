<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackageId>UmbHost.Automate.Teams</PackageId>
    <Version>1.0.0</Version>
    <Authors>UmbHost</Authors>
    <Company>UmbHost</Company>
    <Description>Microsoft Teams (Workflows webhook) connection and a Post Card action for Umbraco Automate.</Description>
    <PackageTags>umbraco;automate;social;teams;microsoft-teams;umbraco-marketplace</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/UmbHost/UmbHost.Automate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/UmbHost/UmbHost.Automate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>umbHostAutomateTeams.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- 17.5.0 is the first Automate release that keeps an action's own log with the step run (ActionContext.LogError, redacted by its
       sanitiser), which the shared error reader writes to (see Shared/NetworkError.cs). -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Automate.Core" Version="[17.5.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.6.0, 19.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="UmbHost.Automate.Teams.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\umbraco-marketplace-umbhost.automate.teams.json" Pack="true" PackagePath="\" />
    <None Include="..\..\umbHostAutomateTeams.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
