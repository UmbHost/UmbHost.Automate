<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>UmbHost.Automate.Bluesky</PackageId>
    <Version>1.0.0</Version>
    <Authors>UmbHost</Authors>
    <Company>UmbHost</Company>
    <Description>Bluesky connection type and a Create Post action for Umbraco Automate.</Description>
    <PackageTags>umbraco;automate;social;bluesky;umbraco-marketplace</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/UmbHost/UmbHost.Automate</PackageProjectUrl>
    <RepositoryUrl>https://github.com/UmbHost/UmbHost.Automate</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>umbHostAutomateBluesky.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- The network's icon ships as a static web asset at /App_Plugins/UmbHost.Automate.Bluesky/ (Umbraco's `icons` extension):
         Umbraco's icon set has no bluesky mark, and the connector shouldn't depend on another package's icons. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <!-- 17.4.0 is the first Automate release that registers its SSRF-protected outbound HTTP client,
       which image downloads go through (see Shared/ImageFetcher.cs). It needs Umbraco CMS 17.6+, hence the CMS floor.
       17.5.0 is the first that keeps an action's own log with the step run (ActionContext.LogError, redacted by its sanitiser), where
       a failed request's whole answer goes (see Shared/NetworkError.cs). -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Automate.Core" Version="[17.5.0, 19.0.0)" />
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.6.0, 19.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="UmbHost.Automate.Bluesky.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\umbraco-marketplace-umbhost.automate.bluesky.json" Pack="true" PackagePath="\" />
    <None Include="..\..\umbHostAutomateBluesky.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
